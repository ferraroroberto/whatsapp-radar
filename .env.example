# WhatsApp Radar — example environment. Copy to .env (ignored) and adjust per host.
# Most of these are not secrets — .env stays ignored regardless. The handful that
# ARE secrets are marked below. This file is the .env surface only; the broader
# config/local.json (see docs/bootstrapping.md) is the canonical place for
# non-env settings such as the household child registry and family rules.

# SQLite path for local state (default: data/whatsapp-radar.sqlite3, ignored).
WR_DB_PATH=data/whatsapp-radar.sqlite3

# Which sources a scan/ingest covers. Comma-separated or JSON list; the switch
# that enables the Gmail source at all (default: whatsapp only).
# WR_SOURCES=whatsapp,gmail

# Connector implementation: fixture (default, offline) | linked_device (real WhatsApp via the
# Node sidecar — run sidecar/ separately and pair a device first; see docs/bootstrapping.md).
WR_CONNECTOR=fixture

# Directory where the Node sidecar writes its buffer (ignored). Default shown.
WR_LINKED_DEVICE_DIR=data/linked_device

# Auto-relaunch the sidecar as the first step of a live scan/resync if its
# heartbeat is stale (the process died but the device is still paired). Default
# on; set to 0/false to instead abort loudly without trying to self-heal.
WR_SIDECAR_AUTOSTART=1
# Override how the sidecar process is launched (default: `node` on PATH).
# WR_NODE_BIN=node
# How often (seconds) the tray's keep-alive supervisor re-checks the sidecar and
# relaunches it if the process died. Linked-device only; honours WR_SIDECAR_AUTOSTART.
# WR_SIDECAR_SUPERVISE_SECONDS=90

# Settled-buffer gate (#73): before a live scan reads the buffer it waits until the
# buffer has stopped growing for WR_SYNC_SETTLE_SECONDS (history backfill finished),
# hard-capped at WR_SYNC_SETTLE_TIMEOUT, so a scan that coincides with a reconnect
# can't read early and skip messages. Set WR_SYNC_SETTLE_SECONDS=0 to disable.
WR_SYNC_SETTLE_SECONDS=12
WR_SYNC_SETTLE_TIMEOUT=90

# Classifier: stub (deterministic keyword, default, no network) | hub (LLM via local-llm-hub)
# | cascade (multilingual keyword prefilter that gates an LLM call — recommended for real use).
WR_CLASSIFIER=stub

# local-llm-hub endpoint + model, used when WR_CLASSIFIER=hub or cascade.
# Default is claude_sonnet: it answers with JSON directly. Avoid reasoning models
# (e.g. agentic_light) whose <think> trace can overrun the token budget and yield
# no parseable JSON.
WR_HUB_BASE_URL=http://127.0.0.1:8000
WR_HUB_MODEL=claude_sonnet
# Output token budget per classification call. Raise it for a reasoning model so
# its <think> trace doesn't truncate before the JSON; a truncated call is recorded
# as 'llm_truncated' in the audit trace (not a generic contract error).
WR_HUB_MAX_TOKENS=8192
# Max characters of the message delta sent in one prompt. Caps a whole-history scan
# so a single request can't blow the model's context window (oldest messages dropped).
WR_HUB_MAX_PROMPT_CHARS=24000
# How many days back the dashboard's "recent alert" memory looks when deciding
# whether a channel already has an outstanding actionable alert. Default: 7.
# WR_HUB_RECENT_ALERT_DAYS=7

# Voice-note transcription (off by default). When enabled, a live scan sends each
# voice note's audio to the hub's Whisper endpoint and writes the transcript back
# into the message; see README "Voice-note transcription".
# WR_TRANSCRIPTION_ENABLED=0
# How many days back a scan looks for untranscribed voice notes. Default: 7.
# WR_TRANSCRIPTION_WINDOW_DAYS=7
# Days to wait before retrying a voice note whose transcription previously failed. Default: 30.
# WR_TRANSCRIPTION_FAILED_RETRY_DAYS=30
# Base URL of the audio/transcription backend (the local-llm-hub's Whisper endpoint). Default shown.
# WR_TRANSCRIPTION_AUDIO_BASE_URL=http://127.0.0.1:8000
# Whisper model name. Default: whisper-vanilla.
# WR_TRANSCRIPTION_MODEL=whisper-vanilla
# Transcription language hint, or "auto" to let Whisper detect it. Default: auto.
# WR_TRANSCRIPTION_LANGUAGE=auto
# Per-request timeout (seconds) for a transcription call. Default: 120.
# WR_TRANSCRIPTION_TIMEOUT=120
# Days a voice note's downloaded audio is retained for in-app playback before it is
# deleted (the transcript is kept either way). Set to 0 to delete immediately after
# a successful transcription. Default: 7.
# WR_TRANSCRIPTION_RETAIN_DAYS=7

# Notification delivery: none (default, records skipped) | telegram.
WR_NOTIFIER=none

# Telegram delivery secrets (used only when WR_NOTIFIER=telegram). These ARE secrets —
# .env is ignored; never commit real values. See docs/bootstrapping.md step 4 to obtain them.
# Canonical home since Step 3 is the gitignored config/webapp_config.json
# (telegram_bot_token / telegram_chat_id); these env vars still override it.
WR_TELEGRAM_BOT_TOKEN=
WR_TELEGRAM_CHAT_ID=

# Tripwire (the "chats worth monitoring" card): bounds on how much of a discovered,
# not-yet-monitored chat's recent history gets scanned for Stage-1 hits. Defaults shown.
# WR_TRIPWIRE_WINDOW_DAYS=7
# WR_TRIPWIRE_MAX_MESSAGES=500
# WR_TRIPWIRE_MAX_MESSAGES_PER_CHAT=20
# Send at most one Telegram nudge per WR_TRIPWIRE_NUDGE_CADENCE_DAYS while tripwire
# hits remain outstanding. Off by default — the in-app card is always available.
# WR_TRIPWIRE_TELEGRAM_NUDGE_ENABLED=0
# WR_TRIPWIRE_NUDGE_CADENCE_DAYS=7

# Gmail source (used when WR_SOURCES includes "gmail"; see docs/gmail-bootstrap.md).
# Paths are relative to the repo root unless absolute. Defaults shown.
# WR_GMAIL_CREDENTIALS_PATH=auth/gmail/credentials.json
# WR_GMAIL_TOKEN_PATH=auth/gmail/token.json
# How many days back a discovery pass looks for new senders. Default: 30.
# WR_GMAIL_DISCOVERY_DAYS=30
# Max messages fetched per discovery pass. Default: 400.
# WR_GMAIL_DISCOVERY_MAX_MESSAGES=400
# Days of Gmail message history retained locally for unmonitored senders. Default: 30.
# WR_GMAIL_RETENTION_DAYS=30

# Family calendar checks (`wr calendar-scan`; off by default, see WR_FAMILY_ENABLED
# below). Paths are relative to the repo root unless absolute. Defaults shown;
# see docs/calendar-bootstrap.md.
# WR_CALENDAR_CREDENTIALS_PATH=auth/calendar/credentials.json
# WR_CALENDAR_TOKEN_PATH=auth/calendar/token.json
# WR_CALENDAR_WRITE_TOKEN_PATH=auth/calendar/write_token.json

# Presence (live phone-position lookup from home-automation, used by the traffic-jam
# "leave now" nudge). Off by default. Default base URL shown.
# WR_PRESENCE_ENABLED=0
# WR_PRESENCE_BASE_URL=http://127.0.0.1:8447
# WR_PRESENCE_VERIFY_TLS=1

# Traffic-jam insurance (`wr traffic-check`; off by default — toggled independently
# from WR_FAMILY_ENABLED, see the Family tab). WR_TRAFFIC_API_KEY falls back to
# GOOGLE_MAPS_API_KEY if unset. WR_TRAFFIC_API_KEY IS a secret — never commit a real value.
# WR_TRAFFIC_ENABLED=0
# WR_TRAFFIC_API_KEY=

# Family calendar-conflict + coverage-gap scan (`wr calendar-scan`; off by default —
# toggled independently from WR_TRAFFIC_ENABLED, see the Family tab).
# WR_FAMILY_ENABLED=0

# Override the config file loaded in place of config/local.json — used by isolated
# processes such as the browser e2e suite that need their own scoped config.
# WR_LOCAL_CONFIG_PATH=

# Port override used by scripts/run_named_tunnel.py when adopting/serving the
# webapp through a named Cloudflare tunnel. Default: 8455 (matches config/default.json).
# WR_WEBAPP_PORT=8455
